<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: exclude everything; the token is encrypted with a device-bound Keystore key
     and would be unusable after a restore anyway. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
